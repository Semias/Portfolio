{
  "name": "portfolio",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "content": "node scripts/build-content.mjs",
    "content:watch": "node scripts/build-content.mjs --watch",
    "prestart": "npm run content",
    "start": "ng serve",
    "prebuild": "npm run content",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "prewatch": "npm run content",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run content",
    "test": "ng test --watch=false",
    "test:watch": "npm run content && ng test",
    "test:scripts": "node --test --test-reporter=spec --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"scripts/tests/*.test.mjs\"",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:visual": "node scripts/e2e-visual.mjs",
    "e2e:visual:update": "node scripts/e2e-visual.mjs --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.5",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.0",
    "marked": "^18.1.2",
    "prettier": "^3.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0",
    "wrangler": "4.154.0",
    "yaml": "^2.9.1"
  }
}
